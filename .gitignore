# Dependencies and local package-manager caches
node_modules/
.npm/
.cache/

# Extension packages and generated build artifacts
*.vsix
artifacts/
dist/
out/
build/

# Downloaded VS Code test hosts, test profiles, and coverage
.vscode-test*/
coverage/
.nyc_output/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Local environment files; keep documented examples versioned
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# Python caches/environments used by development scripts
__pycache__/
*.py[cod]
.venv/

# Personal editor state (shared .vscode launch/tasks files stay versioned)
.idea/
.history/

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Keep package-lock.json, Unicode data, translations, licenses, and media assets.
# .vscodeignore separately controls what is included in a published VSIX.
